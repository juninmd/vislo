{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPic",
  "version": "0.1.0",
  "identifier": "dev.juninmd.openpic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenPic",
        "width": 960,
        "height": 640,
        "minWidth": 360,
        "minHeight": 280,
        "center": true,
        "visible": false,
        "backgroundColor": "#0e0e10",
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["jpg", "jpeg", "jpe", "jfif"], "name": "JPEG image", "description": "JPEG image", "role": "Viewer" },
      { "ext": ["png"], "name": "PNG image", "description": "PNG image", "role": "Viewer" },
      { "ext": ["gif"], "name": "GIF image", "description": "GIF image", "role": "Viewer" },
      { "ext": ["webp"], "name": "WebP image", "description": "WebP image", "role": "Viewer" },
      { "ext": ["bmp"], "name": "Bitmap image", "description": "Bitmap image", "role": "Viewer" },
      { "ext": ["avif"], "name": "AVIF image", "description": "AVIF image", "role": "Viewer" }
    ]
  }
}
