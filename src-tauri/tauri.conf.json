{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vislo",
  "version": "0.1.0",
  "identifier": "dev.juninmd.vislo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost vislo: http://vislo.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["jpg", "jpeg", "jpe", "jfif", "jif", "jfi", "pjpeg", "pjp"], "name": "JPEG image", "description": "JPEG image", "role": "Viewer" },
      { "ext": ["png", "apng"], "name": "PNG image", "description": "PNG image", "role": "Viewer" },
      { "ext": ["gif"], "name": "GIF image", "description": "GIF image", "role": "Viewer" },
      { "ext": ["webp"], "name": "WebP image", "description": "WebP image", "role": "Viewer" },
      { "ext": ["bmp", "dib"], "name": "Bitmap image", "description": "Bitmap image", "role": "Viewer" },
      { "ext": ["avif"], "name": "AVIF image", "description": "AVIF image", "role": "Viewer" },
      { "ext": ["tif", "tiff"], "name": "TIFF image", "description": "TIFF image", "role": "Viewer" },
      { "ext": ["tga"], "name": "Targa image", "description": "Targa image", "role": "Viewer" },
      { "ext": ["psd"], "name": "Photoshop image", "description": "Photoshop image", "role": "Viewer" },
      { "ext": ["ico"], "name": "Icon", "description": "Icon", "role": "Viewer" },
      { "ext": ["pbm", "pgm", "ppm", "pnm", "pam"], "name": "Netpbm image", "description": "Netpbm image", "role": "Viewer" },
      { "ext": ["hdr", "exr"], "name": "HDR image", "description": "HDR image", "role": "Viewer" },
      { "ext": ["dds", "qoi", "ff"], "name": "Texture image", "description": "DDS / QOI / farbfeld image", "role": "Viewer" },
      { "ext": ["dng", "cr2", "cr3", "crw", "nef", "nrw", "arw", "srf", "sr2", "orf", "rw2", "raf", "pef", "srw", "x3f", "3fr", "fff", "iiq", "mef", "mos", "mrw", "dcr", "kdc", "erf", "rwl", "raw"], "name": "RAW photo", "description": "RAW photo (embedded preview)", "role": "Viewer" }
    ]
  }
}
