{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vislo",
  "version": "0.13.0",
  "identifier": "dev.juninmd.vislo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' vislo: http://vislo.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["jpg", "jpeg", "jpe", "jfif", "jif", "jfi", "pjpeg", "pjp", "mpo", "jps"], "name": "JPEG image", "description": "JPEG image", "role": "Viewer" },
      { "ext": ["png", "apng"], "name": "PNG image", "description": "PNG image", "role": "Viewer" },
      { "ext": ["gif"], "name": "GIF image", "description": "GIF image", "role": "Viewer" },
      { "ext": ["webp"], "name": "WebP image", "description": "WebP image", "role": "Viewer" },
      { "ext": ["bmp", "dib"], "name": "Bitmap image", "description": "Bitmap image", "role": "Viewer" },
      { "ext": ["avif", "avifs"], "name": "AVIF image", "description": "AVIF image", "role": "Viewer" },
      { "ext": ["tif", "tiff"], "name": "TIFF image", "description": "TIFF image", "role": "Viewer" },
      { "ext": ["tga", "vda", "icb", "vst"], "name": "Targa image", "description": "Targa image", "role": "Viewer" },
      { "ext": ["psd", "psb"], "name": "Photoshop image", "description": "Photoshop image", "role": "Viewer" },
      { "ext": ["ico", "cur"], "name": "Icon", "description": "Icon", "role": "Viewer" },
      { "ext": ["svg", "svgz"], "name": "SVG image", "description": "SVG vector image", "role": "Viewer" },
      { "ext": ["jxl"], "name": "JPEG XL image", "description": "JPEG XL image", "role": "Viewer" },
      { "ext": ["jp2", "j2k", "j2c", "jpc", "jpf", "jpx"], "name": "JPEG 2000 image", "description": "JPEG 2000 image", "role": "Viewer" },
      { "ext": ["pbm", "pgm", "ppm", "pnm", "pam"], "name": "Netpbm image", "description": "Netpbm image", "role": "Viewer" },
      { "ext": ["hdr", "exr", "rgbe", "xyze"], "name": "HDR image", "description": "HDR image", "role": "Viewer" },
      { "ext": ["dds", "qoi", "ff"], "name": "Texture image", "description": "DDS / QOI / farbfeld image", "role": "Viewer" },
      { "ext": ["pcx", "sgi", "iris", "bw", "xbm", "bm", "xpm", "wbmp", "otb", "icns"], "name": "Legacy bitmap", "description": "PCX / SGI / XBM / XPM / WBMP / OTB / ICNS image", "role": "Viewer" },
      { "ext": ["heic", "heif", "hif"], "name": "HEIF image", "description": "HEIC / HEIF image (needs the Windows HEIF and HEVC extensions)", "role": "Viewer" },
      { "ext": ["jxr", "wdp", "hdp", "wmp"], "name": "JPEG XR image", "description": "JPEG XR image", "role": "Viewer" },
      { "ext": ["ras", "sun"], "name": "Sun Raster image", "description": "Sun Raster image", "role": "Viewer" },
      { "ext": ["fits", "fit", "fts"], "name": "FITS image", "description": "FITS astronomy image (stretched greyscale)", "role": "Viewer" },
      { "ext": ["dpx"], "name": "DPX image", "description": "DPX film frame", "role": "Viewer" },
      { "ext": ["jb2", "jbig2", "cals"], "name": "Fax document image", "description": "JBIG2 / CALS (Group 4) black-and-white document", "role": "Viewer" },
      { "ext": ["wmf", "emf"], "name": "Windows metafile", "description": "WMF / EMF vector picture (drawn by Windows)", "role": "Viewer" },
      { "ext": ["mng"], "name": "MNG image", "description": "MNG animation (first image)", "role": "Viewer" },
      { "ext": ["jng"], "name": "JNG image", "description": "JPEG Network Graphics image", "role": "Viewer" },
      { "ext": ["xwd"], "name": "X Window Dump", "description": "X Window Dump image", "role": "Viewer" },
      { "ext": ["iff", "lbm", "ilbm"], "name": "Amiga IFF image", "description": "Amiga IFF ILBM image", "role": "Viewer" },
      { "ext": ["pct", "pict"], "name": "PICT image", "description": "Macintosh PICT image", "role": "Viewer" },
      { "ext": ["blp"], "name": "BLP texture", "description": "Blizzard BLP texture", "role": "Viewer" },
      { "ext": ["dcx"], "name": "DCX image", "description": "DCX fax image (first page)", "role": "Viewer" },
      { "ext": ["jls"], "name": "JPEG-LS", "description": "JPEG-LS image", "role": "Viewer" },
      { "ext": ["ora", "kra"], "name": "Layered document", "description": "OpenRaster / Krita document (merged preview)", "role": "Viewer" },
      { "ext": ["dng", "cr2", "cr3", "crw", "nef", "nrw", "arw", "srf", "sr2", "orf", "rw2", "raf", "pef", "srw", "x3f", "3fr", "fff", "iiq", "mef", "mos", "mrw", "dcr", "kdc", "erf", "rwl", "raw", "arq", "gpr", "ori", "k25"], "name": "RAW photo", "description": "RAW photo (embedded preview)", "role": "Viewer" }
    ]
  }
}
